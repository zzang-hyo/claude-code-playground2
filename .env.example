# Copy this file to `.env` and fill in the values from your own Firebase
# project (Firebase console -> Project settings -> your web app -> SDK setup
# and configuration). See SETUP.md for the full step-by-step guide.
#
# Note: these are Firebase's public client identifiers, not secrets — they
# are safe to expose in the built JS bundle. They're kept in env vars purely
# so this same source code works with any Firebase project without edits.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
